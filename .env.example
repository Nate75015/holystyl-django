# ── Holystyl Django — variables d'environnement ─────────────────────
# Copier en `.env` et renseigner. Aucune valeur secrète ne doit être commitée.

# Cœur
DJANGO_ENV=dev                     # dev | prod
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:8000

# Base de données PostgreSQL
DATABASE_URL=postgres://localhost:5432/holystyl

# Temps réel / async (prod)
REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true      # true en dev (pas de worker/Redis requis)

# ── Services tiers (activés au fil des tranches) ────────────────────
# IA — Google Gemini (Tranche 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email SMTP (Tranche 4 / prod)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@holystyl.com
SMTP_USE_TLS=true
ADMIN_EMAIL=

# SMS / WhatsApp — Twilio (Tranche 4)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Paiements — Stripe (Tranche 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stockage S3 (prod)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Cartographie — Google Maps (Tranche 1/2)
GOOGLE_MAPS_API_KEY=
